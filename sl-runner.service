[Unit]
Description=SL Runner deployment daemon
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=sl-runner
Group=sl-runner
SupplementaryGroups=docker
Environment=DOCKER_CONFIG=/etc/sl-runner/docker
ExecStart=/opt/sl-runner/sl-runner --config /etc/sl-runner/config.json daemon
Restart=on-failure
RestartSec=5s
StateDirectory=sl-runner
StateDirectoryMode=0700
UMask=0077
TimeoutStopSec=360s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
